# EconSim Environment Variables Configuration Template
# In production on Render or GitHub Secrets, set these environment variables.

# Application
APP_NAME=EconSim
APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET=generate-a-secure-32-byte-hex-string

# Aiven MySQL Database Connection
DB_HOST=mysql-xxxx-xxxx.aivencloud.com
DB_PORT=25060
DB_NAME=econsim
DB_USER=avnadmin
DB_PASSWORD=
# Path to downloaded Aiven CA pem file, OR provide raw PEM content in DB_SSL_CA_CONTENT
DB_SSL_CA=
DB_SSL_CA_CONTENT=
DB_SSL_VERIFY=true

# Transactional Mailer (Resend / SendGrid / Log)
MAILER_PROVIDER=resend
MAILER_API_KEY=
MAILER_FROM_EMAIL=onboarding@econsim.app
MAILER_FROM_NAME="EconSim Intelligence"

# Python AI Agent / NVIDIA NIM Evaluation (Used by GitHub Actions & Evaluator)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

